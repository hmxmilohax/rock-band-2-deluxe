#define DX_FPS_SETUP
( ; bruh wtf is all this
	{{$world iterate PostProc $p {unless {== $p "photocopy.pp"} {$p set emulate_fps $emulatefps}}}}
	{if {>= $emulatefps 25} 
      {$char iterate CharHair $hair {$hair reset 35}}
   	{$world iterate WorldDir $wd 
         {$wd iterate BandCamShot $bcs
         	{foreach $property (shake_noisefreq shake_noiseamp) 
               {$bcs set (keyframes $i $property) {if_else $dx_camshake 0 {* {$bcs get (keyframes $i $property)} 0.25}}}
            }
            {foreach $component (x y) 
               {$bcs set (keyframes $i shake_maxangle $component) {if_else $dx_camshake 0 {* {$bcs get (keyframes $i shake_maxangle $component)} 0.25}}}
            }
         }
      }
   }
)

#define LOAD_DX_SETTINGS
(
   {set $trackspeed {$dxsettings get trackspeed}}
   {set $tracklength {$dxsettings get tracklength}}
